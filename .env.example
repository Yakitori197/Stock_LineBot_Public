# LINE Messaging API 憑證（LINE Developers Console；勿提交真實值）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 伺服器
PORT=5000
DEBUG=False

# 到價提醒（秒）
ALERT_CHECK_INTERVAL=60

# 自選股 / 到價提醒的 SQLite 路徑
# webhook 與 scheduler 必須指向同一個檔案，提醒才會被排程器讀到
# （docker-compose 已用具名 volume 共用 /app/data）
DB_PATH=data/linebot.db
